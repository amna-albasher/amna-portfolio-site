---
import serverIcon from "lucide-static/icons/server.svg?raw";
import boxIcon from "lucide-static/icons/box.svg?raw";
import workflowIcon from "lucide-static/icons/workflow.svg?raw";
import shieldIcon from "lucide-static/icons/shield.svg?raw";
import barChartIcon from "lucide-static/icons/bar-chart-3.svg?raw";
import databaseIcon from "lucide-static/icons/database.svg?raw";

const groups = [
  {
    id: "infrastructure",
    title: "Infrastructure",
    icon: serverIcon,
    items: ["Terraform", "Bicep", "Azure Resource Manager"],
  },
  {
    id: "containers",
    title: "Containers",
    icon: boxIcon,
    items: ["Docker", "Kubernetes", "AKS", "Helm"],
  },
  {
    id: "gitops",
    title: "GitOps & CI/CD",
    icon: workflowIcon,
    items: ["GitHub Actions", "Azure DevOps", "ArgoCD"],
  },
  {
    id: "security",
    title: "Security",
    icon: shieldIcon,
    items: ["Azure Key Vault", "Trivy", "SonarQube", "IAM"],
  },
  {
    id: "observability",
    title: "Observability",
    icon: barChartIcon,
    items: ["Prometheus", "Grafana", "Azure Monitor"],
  },
  {
    id: "mlops",
    title: "MLOps & Data",
    icon: databaseIcon,
    items: ["Python", "FastAPI", "SQL", "Azure Machine Learning"],
  },
];
---

<section id="skills" class="relative overflow-hidden border-t border-white/10 bg-ink py-16 text-paper">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-96 w-96 -translate-x-1/2 -translate-y-1/3 rounded-full bg-pink/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6 lg:px-10">
    <div class="reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink">Toolbox</p>
      <h2 class="mt-2 font-display text-4xl font-bold uppercase tracking-tight text-paper sm:text-5xl">
        Skills
      </h2>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((group) => (
        <div class="reveal flex min-h-[210px] flex-col rounded-2xl border border-white/10 bg-white/5 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-pink/50 hover:bg-white/10">
          <div class="flex items-center gap-3">
            <span class="skill-icon flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-pink/15 text-pink" set:html={group.icon} />
            <h3 class="font-display text-lg font-semibold text-paper">{group.title}</h3>
          </div>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-full border border-white/15 px-3 py-1 text-xs font-medium text-paper/80">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
