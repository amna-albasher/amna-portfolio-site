---
const faqs = [
  {
    question: "What do you specialize in?",
    answer:
      "I specialize in Cloud DevOps and MLOps on Azure. I build Kubernetes platforms, GitOps-driven CI/CD pipelines, infrastructure as code with Terraform and Bicep, and MLOps pipelines that take models from training to a monitored production endpoint.",
  },
  {
    question: "Are you open to full-time roles or contract work?",
    answer:
      "Yes, I'm open to both full-time roles and contract engagements. If your team needs cloud infrastructure, platform engineering, or MLOps work, whether ongoing or project-based, I'd be glad to talk.",
  },
  {
    question: "What industries have you worked with?",
    answer:
      "I've worked across data-driven and operations-heavy environments, building infrastructure and tooling that hold up under real production load rather than staying a proof of concept.",
  },
  {
    question: "How can we start a conversation?",
    answer:
      "The fastest way is to email me directly or reach out on LinkedIn. Both links are in the closing section below, and I usually respond within a day or two.",
  },
];
---

<section class="border-t border-line/70 bg-white py-16">
  <div class="mx-auto max-w-3xl px-6 lg:px-10">
    <div class="reveal text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink">Questions</p>
      <h2 class="mt-2 font-display text-4xl font-bold uppercase tracking-tight text-ink sm:text-5xl">
        FAQ
      </h2>
    </div>

    <div class="reveal mt-10 divide-y divide-line/70 border-y border-line/70">
      {faqs.map((faq, i) => (
        <details class="group py-5 transition-colors duration-200 hover:bg-paper/60" name="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-2 font-display text-lg font-semibold text-ink marker:content-none">
            {faq.question}
            <span
              class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-line text-pink transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-3 px-2 text-sm leading-relaxed text-ink-soft">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
