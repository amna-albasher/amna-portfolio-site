---
import ContactForm from "./ContactForm.astro";
---

<section id="contact" class="border-t border-line/70 bg-ink pt-16 pb-10">
  <div class="reveal mx-auto max-w-4xl px-6 text-center lg:px-10">
    <h2 class="font-display text-4xl font-bold uppercase tracking-tight text-paper sm:text-5xl">
      Ready to Build Reliable Infrastructure?
    </h2>
    <p class="mt-4 text-lg text-paper/70">
      Let's discuss your cloud architecture, DevOps automation, or MLOps pipeline needs.
    </p>

    <div class="reveal mx-auto mt-10 max-w-md">
      <ContactForm />
    </div>

    <div class="mt-4 flex justify-center">
      <a
        href="https://www.linkedin.com/in/amna-albasher-5139181aa/"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-1 text-base font-normal text-paper/80"
      >
        Prefer LinkedIn?
        <span class="font-semibold text-pink transition-colors group-hover:text-pink-dark">
          Connect with me
          <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">&rarr;</span>
        </span>
      </a>
    </div>
  </div>
</section>
