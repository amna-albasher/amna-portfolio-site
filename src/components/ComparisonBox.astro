---
interface Row {
  label: string;
  value: string;
}

interface Column {
  title: string;
  rows: Row[];
}

interface Props {
  columns: Column[];
  accent?: string;
  class?: string;
}

const { columns, accent = "#4c3ae3", class: className = "" } = Astro.props;
const gridClass = columns.length === 2 ? "sm:grid-cols-2" : "sm:grid-cols-3";
---

<div
  class:list={["not-prose my-8 rounded-2xl border border-line p-6", className]}
  style={{
    borderTop: `3px solid ${accent}`,
    background: `color-mix(in srgb, ${accent} 6%, white)`,
  }}
>
  <div class:list={["grid gap-6", gridClass]}>
    {columns.map((column) => (
      <div>
        <p class="font-display text-sm font-semibold text-ink" style={{ color: accent }}>
          {column.title}
        </p>
        <dl class="mt-3 space-y-3 border-t border-line/70 pt-3">
          {column.rows.map((row) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-ink-soft/70">{row.label}</dt>
              <dd class="mt-0.5 text-sm text-ink">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
</div>
