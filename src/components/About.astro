---
import awardIcon from "lucide-static/icons/award.svg?raw";

const stats = [
  { value: 3, suffix: "", label: "Microsoft Certifications" },
  { value: 9, suffix: "+", label: "Production-Grade Projects" },
  { value: 5, suffix: "+", label: "Years of Hands-On Experience" },
];

const certifications = [
  { code: "AZ-104", name: "Azure Administrator", image: "/images/certs/az-104.png" },
  { code: "AZ-305", name: "Azure Solutions Architect Expert", image: "/images/certs/az-305.png" },
  {
    code: "MLOps Associate",
    name: "Machine Learning Operations (MLOps) Engineer Associate",
    image: "/images/certs/mlops-associate.jpg",
  },
];
---

<section id="about" class="border-t border-line/70 bg-paper py-4">
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <div class="reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink">Know Me More</p>
      <h2 class="mt-2 font-display text-4xl font-bold uppercase tracking-tight text-ink sm:text-5xl">
        About Me
      </h2>
    </div>

    <div class="mt-5 grid gap-5 lg:grid-cols-2 lg:gap-8">
      <div class="reveal flex flex-col lg:h-full">
        <p class="font-display text-2xl font-semibold leading-snug text-ink sm:text-3xl">
          Hi, I'm Amna, a Cloud DevOps &amp; MLOps Engineer with hands-on experience across
          Azure infrastructure and ML systems.
        </p>
        <div class="mt-6 flex flex-wrap gap-5 lg:mt-auto lg:pt-6">
          {certifications.map((cert) => (
            <div class="flex flex-col items-center gap-2 text-center" title={cert.name}>
              {cert.image ? (
                <div class="flex h-[116px] w-[116px] flex-shrink-0 items-center justify-center rounded-xl border border-line bg-white p-2 shadow-sm">
                  <img
                    src={cert.image}
                    alt={`${cert.name} badge`}
                    class="h-full w-full object-contain"
                    width="100"
                    height="100"
                  />
                </div>
              ) : (
                <span class="flex h-[116px] w-[116px] flex-shrink-0 items-center justify-center rounded-xl border border-dashed border-line text-ink-soft/50">
                  <span class="placeholder-icon h-11 w-11" set:html={awardIcon} />
                </span>
              )}
              <div class="leading-tight">
                <span class="block text-xs font-semibold text-ink-soft">{cert.code}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="reveal space-y-2.5 text-base leading-relaxed text-ink-soft">
        <p>
          I design and operate cloud infrastructure on Azure, provisioning with Terraform and
          Bicep, running production workloads on Kubernetes (AKS), and wiring up GitOps pipelines
          so deployments are repeatable and auditable instead of manual and risky.
        </p>
        <p>
          Security and observability aren't an afterthought in my builds: secrets live in Azure
          Key Vault, images get scanned before they ship, and every platform I stand up comes with
          Prometheus and Grafana wired in from day one. On the MLOps side, I build the pipelines
          that take a model from notebook to production endpoint and keep it observable once it's
          live.
        </p>
        <p>
          I hold Microsoft certifications spanning Azure administration, solutions architecture,
          and MLOps engineering.
        </p>
      </div>
    </div>

    <div class="reveal mt-5 grid grid-cols-1 gap-4 border-t border-line/70 pt-4 sm:grid-cols-3">
      {stats.map((stat) => (
        <div>
          <p class="font-display text-5xl font-bold text-pink sm:text-6xl">
            <span data-count-to={stat.value} data-count-suffix={stat.suffix}>0</span>
          </p>
          <p class="mt-2 text-sm font-medium text-ink-soft">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
