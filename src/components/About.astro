---
import awardIcon from "lucide-static/icons/award.svg?raw";

const stats = [
  { value: 3, suffix: "", label: "Microsoft Certifications" },
  { value: 9, suffix: "+", label: "Hands-On Projects" },
  { value: 5, suffix: "+", label: "Years of Hands-On Experience" },
];

const certifications = [
  { code: "AZ-104", name: "Azure Administrator", image: "/images/certs/az-104.png" },
  { code: "AZ-305", name: "Azure Solutions Architect Expert", image: "/images/certs/az-305.png" },
  {
    code: "MLOps Associate",
    name: "Machine Learning Operations (MLOps) Engineer Associate",
    image: "/images/certs/mlops-associate.jpg",
  },
];
---

<section id="about" class="border-t border-line/70 bg-paper pb-[10px] pt-[5px]">
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <div class="reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink">Know Me More</p>
      <h2 class="mt-2 font-display text-4xl font-bold uppercase tracking-tight text-ink sm:text-5xl">
        About Me
      </h2>
    </div>

    <div class="mt-5 grid items-start gap-5 lg:grid-cols-2 lg:gap-8">
      <div class="reveal flex flex-col">
        <div class="flex flex-wrap gap-5">
          {certifications.map((cert) => (
            <div class="flex flex-col items-center gap-2 text-center" title={cert.name}>
              {cert.image ? (
                <div class="flex h-[158px] w-[158px] flex-shrink-0 items-center justify-center rounded-xl border border-line bg-white p-2 shadow-sm">
                  <img
                    src={cert.image}
                    alt={`${cert.name} badge`}
                    class="h-full w-full object-contain"
                    width="140"
                    height="140"
                  />
                </div>
              ) : (
                <span class="flex h-[158px] w-[158px] flex-shrink-0 items-center justify-center rounded-xl border border-dashed border-line text-ink-soft/50">
                  <span class="placeholder-icon h-14 w-14" set:html={awardIcon} />
                </span>
              )}
              <div class="leading-tight">
                <span class="block text-sm font-semibold text-ink-soft">{cert.code}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="reveal space-y-2.5 text-lg leading-relaxed">
        <p style="color: #1a1a1a">
          I'm a Cloud DevOps Engineer working with Azure infrastructure and MLOps. I build and
          automate cloud infrastructure, and work on deploying machine learning models.
        </p>
        <p style="color: #1a1a1a">
          I work with Azure infrastructure, Kubernetes, and Terraform, with a focus on automation,
          security, and monitoring. I'm also applying that foundation to MLOps workflows,
          connecting development, deployment, and monitoring.
        </p>
      </div>
    </div>

    <div class="reveal mt-5 grid grid-cols-1 gap-4 border-t border-line/70 pt-4 sm:grid-cols-3">
      {stats.map((stat) => (
        <div>
          <p class="font-display text-5xl font-bold text-pink sm:text-6xl">
            <span data-count-to={stat.value} data-count-suffix={stat.suffix}>0</span>
          </p>
          <p class="mt-2 text-sm font-medium text-ink-soft">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
