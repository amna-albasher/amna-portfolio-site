---
interface Props {
  command: string;
  lines: string[];
  class?: string;
  aspect?: string;
}

const { command, lines, class: className = "", aspect = "aspect-[4/3]" } = Astro.props;
---

<div
  class:list={["relative overflow-hidden rounded-2xl border border-white/10 bg-[#0b0f14]", aspect, className]}
  role="img"
  aria-label={`Mock terminal output for ${command}`}
>
  <div class="flex h-8 items-center border-b border-white/10 bg-white/5 px-3">
    <span class="flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    </span>
  </div>
  <div class="p-4 font-mono text-[13px] leading-relaxed sm:text-sm">
    <p class="text-pink">
      <span class="text-white/40">$</span> {command}
    </p>
    {lines.map((line) => (
      <p class="mt-1 text-[#4ade80]">
        <span aria-hidden="true">✓</span> {line}
      </p>
    ))}
  </div>
</div>
