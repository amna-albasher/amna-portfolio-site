---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ArchitectureDiagram from "../../components/ArchitectureDiagram.astro";
import MerchantGuardArchitecture from "../../components/MerchantGuardArchitecture.astro";
import TableOfContents from "../../components/TableOfContents.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);

const approachHeading = project.data.approachHeading ?? (project.id === "azure-finops-dashboard" ? "Solution" : "Approach");
const approachSlug = approachHeading.toLowerCase();
const walkthroughHeading = project.data.walkthroughHeading ?? "Dashboard Walkthrough";
const showsArchitecture = project.data.showArchitecture ?? project.id !== "azure-finops-dashboard";
const tocHeadings = [
  { depth: 2, slug: "problem", text: "Problem" },
  { depth: 2, slug: approachSlug, text: approachHeading },
  ...(project.data.dashboardWalkthrough
    ? [{ depth: 2, slug: "dashboard-walkthrough", text: walkthroughHeading }]
    : []),
  ...(project.data.technicalImplementation
    ? [{ depth: 2, slug: "technical-implementation", text: "Technical Implementation" }]
    : []),
  { depth: 2, slug: "key-decisions", text: "Key Decisions" },
  ...(showsArchitecture ? [{ depth: 2, slug: "architecture", text: "Architecture" }] : []),
  { depth: 2, slug: "results", text: "Results" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.description,
  creator: {
    "@type": "Person",
    name: "Amna Albasher",
  },
  keywords: project.data.tech.join(", "),
};
---

<BaseLayout
  title={`${project.data.title} Case Study | Amna Albasher`}
  description={project.data.summary}
  path={`/portfolio/${project.id}`}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="py-16">
    <div class="mx-auto max-w-6xl px-6 lg:px-10">
     <div class="max-w-3xl">
      {project.id !== "devsecops-scorecard" && (
        <a href="/#portfolio" class="text-sm font-semibold text-pink">&larr; Back to Portfolio</a>
      )}

      <!-- 1. Header -->
      <span class="mt-6 block text-xs font-semibold uppercase tracking-[0.2em] text-pink">
        {project.data.category}
      </span>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        {project.data.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{project.data.summary}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {project.data.tech.map((t) => (
          <li class="rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-soft">{t}</li>
        ))}
      </ul>

      {project.id === "merchantguard" && (
        <section class="mt-8" aria-labelledby="project-walkthrough">
          <h2 id="project-walkthrough" class="font-display text-2xl font-semibold text-ink">Project Walkthrough</h2>
          <video
            class="mt-4 block w-full rounded-2xl border border-line"
            src="/videos/merchantguard-walkthrough.mp4"
            controls
            playsinline
            preload="metadata"
            aria-label="MerchantGuard walkthrough video"
          />
        </section>
      )}

      {project.id !== "merchantguard" && project.data.heroImage && (
        <figure class="mx-0 mt-6 w-full">
          <img
            src={project.data.heroImage}
            alt={project.data.heroImageAlt ?? project.data.title}
            class="w-full rounded-2xl border border-line"
            loading="eager"
          />
        </figure>
      )}

      <div class="mt-4 flex flex-wrap items-center gap-4">
        {project.data.github && (
          <a
            href={project.data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-ink-soft transition-colors hover:text-pink"
          >
            GitHub &#8599;
          </a>
        )}
        {project.data.liveDemo && (
          <a
            href={project.data.liveDemo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-ink-soft transition-colors hover:text-pink"
          >
            Live Demo &#8599;
          </a>
        )}
      </div>

      {project.data.role && (
        <div class="mt-6 rounded-xl border border-line bg-pink-soft/40 px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink">Role &amp; Context</p>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{project.data.role}</p>
        </div>
      )}
     </div>
    </div>

    <div class="mx-auto mt-12 max-w-6xl px-6 lg:grid lg:grid-cols-[1fr_280px] lg:items-start lg:gap-16 lg:px-10">
      <div class="space-y-12">
        <!-- 4. Problem -->
        <section id="problem">
          <h2 class="font-display text-2xl font-semibold text-ink">Problem</h2>
          <div class="mt-3 space-y-3 text-base leading-relaxed text-ink-soft">
            {project.data.problem.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- 5. Approach / Solution -->
        <section id={approachSlug}>
          <h2 class="font-display text-2xl font-semibold text-ink">
            {approachHeading}
          </h2>
          <div class="mt-3 space-y-3 text-base leading-relaxed text-ink-soft">
            {project.data.approach.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        {project.data.dashboardWalkthrough && (
          <section id="dashboard-walkthrough">
            <h2 class="font-display text-2xl font-semibold text-ink">{walkthroughHeading}</h2>
            {project.id === "merchantguard" && project.data.heroImage && (
              <figure class="mx-0 mt-5 w-full">
                <img
                  src={project.data.heroImage}
                  alt={project.data.heroImageAlt ?? project.data.title}
                  class="w-full rounded-2xl border border-line"
                  loading="lazy"
                />
              </figure>
            )}
            <div class="mt-5 space-y-8">
              {project.data.dashboardWalkthrough.map((item) => (
                <div>
                  <h3 class="font-display text-xl font-semibold text-ink">{item.title}</h3>
                  <p class="mt-2 text-base leading-relaxed text-ink-soft">{item.description}</p>
                  {item.image && (
                    <figure class="mx-0 mt-4 w-full">
                      <img
                        src={item.image}
                        alt={item.imageAlt ?? item.title}
                        class="w-full rounded-2xl border border-line"
                        loading="lazy"
                      />
                    </figure>
                  )}
                  {!item.image && item.placeholder && (
                    <div class="mt-4 flex aspect-[16/9] items-center justify-center rounded-2xl border border-dashed border-line bg-white text-sm font-medium text-ink-soft">
                      {item.placeholder}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        {project.data.technicalImplementation && (
          <section id="technical-implementation">
            <h2 class="font-display text-2xl font-semibold text-ink">Technical Implementation</h2>
            <div class="mt-3 space-y-3 text-base leading-relaxed text-ink-soft">
              {project.data.technicalImplementation.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        )}

        <!-- Key Decisions -->
        <section id="key-decisions">
          <h2 class="font-display text-2xl font-semibold text-ink">Key Decisions</h2>
          <ul class="mt-3 space-y-2">
            {project.data.keyDecisions.map((decision) => (
              <li class="flex gap-3 text-base leading-relaxed text-ink-soft">
                <span class="mt-1 text-pink" aria-hidden="true">&#9670;</span>
                <span>{decision}</span>
              </li>
            ))}
          </ul>
          {project.data.keyDecisionsImage && (
            <figure class="mx-0 mt-6 w-full">
              <img
                src={project.data.keyDecisionsImage}
                alt={project.data.keyDecisionsImageCaption || `${project.data.title} screenshot`}
                class="w-full rounded-2xl border border-line"
              />
              {project.data.keyDecisionsImageCaption && (
                <figcaption class="mt-2 text-sm text-ink-soft">{project.data.keyDecisionsImageCaption}</figcaption>
              )}
            </figure>
          )}
        </section>

        {showsArchitecture && (
          <section id="architecture">
            <h2 class="font-display text-2xl font-semibold text-ink">Architecture</h2>
            <p class="mt-3 text-base leading-relaxed text-ink-soft">{project.data.architecture}</p>
            {project.id === "merchantguard" ? (
              <MerchantGuardArchitecture />
            ) : (
              <ArchitectureDiagram
                nodes={project.data.architectureNodes ?? project.data.tech.slice(0, 4)}
                accent={project.data.accent}
                class="mt-4 aspect-[16/9]"
              />
            )}
          </section>
        )}

        <!-- 7. Results -->
        <section id="results">
          <h2 class="font-display text-2xl font-semibold text-ink">Results</h2>
          <ul class="mt-3 space-y-2">
            {project.data.results.map((result) => (
              <li class="flex gap-3 text-base leading-relaxed text-ink-soft">
                <span class="mt-1 text-pink" aria-hidden="true">&#9670;</span>
                <span>{result}</span>
              </li>
            ))}
          </ul>
        </section>

        <div class="prose max-w-none text-ink-soft">
          <Content />
        </div>
      </div>

      <aside class="mt-14 lg:sticky lg:top-24 lg:mt-0">
        <TableOfContents headings={tocHeadings} />
      </aside>
    </div>

    <div class="mx-auto max-w-6xl px-6 lg:px-10">
     <div class="max-w-3xl">
      <!-- 9. Bottom nav -->
      <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-line/70 pt-8">
        <a href="/#portfolio" class="text-sm font-semibold text-pink">&larr; Back to Portfolio</a>
        <a href={`/portfolio/${next.id}`} class="flex items-center gap-2 text-sm font-semibold text-pink">
          Next project: {next.data.title} &rarr;
        </a>
      </div>

      <a
        href="/#contact"
        class="mt-8 inline-block rounded-full bg-pink px-7 py-3.5 text-sm font-semibold text-white shadow-md transition-transform hover:-translate-y-0.5 hover:bg-pink-dark"
      >
        Let's Talk About Your Project
      </a>
     </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
