---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import TerminalMock from "../../components/TerminalMock.astro";
import ArchitectureDiagram from "../../components/ArchitectureDiagram.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.description,
  creator: {
    "@type": "Person",
    name: "Amna Albasher",
  },
  keywords: project.data.tech.join(", "),
};
---

<BaseLayout
  title={`${project.data.title} Case Study | Amna Albasher`}
  description={project.data.summary}
  path={`/portfolio/${project.id}`}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="py-16">
    <div class="mx-auto max-w-3xl px-6 lg:px-10">
      <a href="/#portfolio" class="text-sm font-semibold text-pink">&larr; Back to Portfolio</a>

      <!-- 1. Header -->
      <span class="mt-6 block text-xs font-semibold uppercase tracking-[0.2em] text-pink">
        {project.data.category}
      </span>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        {project.data.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{project.data.summary}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {project.data.tech.map((t) => (
          <li class="rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-soft">{t}</li>
        ))}
      </ul>

      <div class="mt-4 flex flex-wrap items-center gap-4">
        <a
          href={project.data.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-ink-soft transition-colors hover:text-pink"
        >
          GitHub &#8599;
        </a>
        {project.data.liveDemo && (
          <a
            href={project.data.liveDemo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-ink-soft transition-colors hover:text-pink"
          >
            Live Demo &#8599;
          </a>
        )}
      </div>

      <!-- 2. Hero visual -->
      <TerminalMock
        command={project.data.terminalCommand}
        lines={project.data.terminalLines}
        class="mt-10"
        aspect="aspect-[16/9]"
      />

      <!-- 3. Watch walkthrough -->
      <button
        type="button"
        data-video-trigger
        class="group relative mt-6 block w-full overflow-hidden rounded-2xl border border-line text-left"
        aria-haspopup="dialog"
      >
        <PlaceholderImage label={`${project.data.title} walkthrough`} accent={project.data.accent} aspect="aspect-video" />
        <span
          class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/25 transition-colors group-hover:bg-black/35"
        >
          <span
            class="flex h-16 w-16 items-center justify-center rounded-full bg-white/95 text-pink shadow-lg transition-transform group-hover:scale-105"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7Z" />
            </svg>
          </span>
          <span class="rounded-full bg-black/50 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
            &#9654; Watch walkthrough
          </span>
        </span>
      </button>

      <div class="mt-12 space-y-12">
        <!-- 4. Problem -->
        <section>
          <h2 class="font-display text-2xl font-semibold text-ink">Problem</h2>
          <div class="mt-3 space-y-3 text-base leading-relaxed text-ink-soft">
            {project.data.problem.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- 5. Approach -->
        <section>
          <h2 class="font-display text-2xl font-semibold text-ink">Approach</h2>
          <div class="mt-3 space-y-3 text-base leading-relaxed text-ink-soft">
            {project.data.approach.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Key Decisions -->
        <section>
          <h2 class="font-display text-2xl font-semibold text-ink">Key Decisions</h2>
          <ul class="mt-3 space-y-2">
            {project.data.keyDecisions.map((decision) => (
              <li class="flex gap-3 text-base leading-relaxed text-ink-soft">
                <span class="mt-1 text-pink" aria-hidden="true">&#9670;</span>
                <span>{decision}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- 6. Architecture -->
        <section>
          <h2 class="font-display text-2xl font-semibold text-ink">Architecture</h2>
          <p class="mt-3 text-base leading-relaxed text-ink-soft">{project.data.architecture}</p>
          <ArchitectureDiagram
            nodes={project.data.tech.slice(0, 4)}
            accent={project.data.accent}
            class="mt-4 aspect-[16/9]"
          />
        </section>

        <!-- 7. Results -->
        <section>
          <h2 class="font-display text-2xl font-semibold text-ink">Results</h2>
          <ul class="mt-3 space-y-2">
            {project.data.results.map((result) => (
              <li class="flex gap-3 text-base leading-relaxed text-ink-soft">
                <span class="mt-1 text-pink" aria-hidden="true">&#9670;</span>
                <span>{result}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- 8. Screenshots gallery -->
        <section>
          <h2 class="font-display text-2xl font-semibold text-ink">Screenshots</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <PlaceholderImage label={`${project.data.title} Screenshot 1`} variant="neutral" />
            <PlaceholderImage label={`${project.data.title} Screenshot 2`} variant="neutral" />
            <PlaceholderImage label={`${project.data.title} Screenshot 3`} variant="neutral" class="sm:col-span-2 lg:col-span-1" />
          </div>
        </section>

        <div class="prose max-w-none text-ink-soft">
          <Content />
        </div>
      </div>

      <!-- 9. Bottom nav -->
      <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-line/70 pt-8">
        <a href="/#portfolio" class="text-sm font-semibold text-pink">&larr; Back to Portfolio</a>
        <a href={`/portfolio/${next.id}`} class="flex items-center gap-2 text-sm font-semibold text-pink">
          Next project: {next.data.title} &rarr;
        </a>
      </div>

      <a
        href="/#contact"
        class="mt-8 inline-block rounded-full bg-pink px-7 py-3.5 text-sm font-semibold text-white shadow-md transition-transform hover:-translate-y-0.5 hover:bg-pink-dark"
      >
        Let's Talk About Your Project
      </a>
    </div>
  </main>
  <Footer />

  <!-- Video placeholder modal -->
  <dialog id="video-modal" class="video-modal">
    <div class="rounded-2xl bg-white p-6 text-center shadow-xl">
      <h3 class="font-display text-xl font-semibold text-ink">Walkthrough video</h3>
      <p class="mt-3 text-sm leading-relaxed text-ink-soft">
        This is where the project walkthrough video will play once it's recorded.
      </p>
      <button
        type="button"
        data-video-close
        class="mt-6 inline-block rounded-full border border-ink/20 px-6 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-pink hover:text-pink"
      >
        Close
      </button>
    </div>
  </dialog>
</BaseLayout>

<style>
  .video-modal {
    border: none;
    border-radius: 1rem;
    padding: 0;
    background: transparent;
    max-width: 32rem;
    width: calc(100% - 2rem);
    max-height: none;
    margin: auto;
  }

  .video-modal::backdrop {
    background: rgba(22, 22, 26, 0.6);
    backdrop-filter: blur(2px);
  }
</style>

<script>
  const modal = document.getElementById("video-modal") as HTMLDialogElement | null;
  const trigger = document.querySelector<HTMLButtonElement>("[data-video-trigger]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-video-close]");

  trigger?.addEventListener("click", () => modal?.showModal());
  closeBtn?.addEventListener("click", () => modal?.close());
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
</script>
