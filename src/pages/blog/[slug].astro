---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BlogCover from "../../components/BlogCover.astro";
import BlogCard from "../../components/BlogCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import layersIcon from "lucide-static/icons/layers.svg?raw";
import forkIcon from "lucide-static/icons/git-fork.svg?raw";
import routeIcon from "lucide-static/icons/route.svg?raw";

const coverIcons: Record<string, string> = {
  layers: layersIcon,
  fork: forkIcon,
  route: routeIcon,
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = (await getCollection("blog")).sort(
  (a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime()
);
const otherPosts = allPosts.filter((p) => p.id !== post.id);

const allCategories = Array.from(new Set(allPosts.flatMap((p) => p.data.categories)));

const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const canonicalURL = new URL(`/blog/${post.id}`, Astro.site).toString();
const shareText = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(canonicalURL);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: "Amna Albasher",
  },
};
---

<BaseLayout
  title={`${post.data.title} | Amna Albasher`}
  description={post.data.description}
  path={`/blog/${post.id}`}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="py-16">
    <div class="mx-auto max-w-5xl px-6 lg:px-10">
      <a href="/blog" class="text-sm font-semibold text-pink">&larr; Back to Blog</a>

      {post.data.comingSoon && (
        <span class="mt-6 inline-block rounded-full bg-pink-soft px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-pink">
          Coming Soon
        </span>
      )}

      <div class="relative mt-6 aspect-[21/9] overflow-hidden rounded-2xl">
        <BlogCover
          icon={coverIcons[post.data.coverIcon]}
          accent={post.data.accent}
          label={post.data.title}
          aspect=""
          class="absolute inset-0 h-full w-full"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/15 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10">
          <h1 class="font-display text-2xl font-bold leading-tight text-white sm:text-3xl lg:text-4xl">
            {post.data.title}
          </h1>
          <div class="mt-4 flex items-center gap-3">
            <img
              src="/images/amna.png"
              alt="Amna Albasher"
              class="h-10 w-10 flex-shrink-0 rounded-full object-cover ring-2 ring-white/60"
              width="40"
              height="40"
            />
            <div>
              <p class="text-sm font-semibold text-white">Amna Albasher</p>
              <p class="text-xs text-white/75">Cloud DevOps &amp; MLOps Engineer &middot; {formattedDate}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-auto mt-14 max-w-6xl px-6 lg:grid lg:grid-cols-[1fr_280px] lg:items-start lg:gap-16 lg:px-10">
      <article class="prose max-w-none text-ink-soft">
        <Content />
      </article>

      <aside class="mt-14 space-y-10 lg:sticky lg:top-24 lg:mt-0">
        <TableOfContents headings={headings} />

        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink">Categories</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {allCategories.map((category) => (
              <a
                href="/blog"
                class:list={[
                  "rounded-full border px-3 py-1 text-xs font-medium transition-colors",
                  post.data.categories.includes(category)
                    ? "border-pink bg-pink-soft text-pink"
                    : "border-line text-ink-soft hover:border-pink/50 hover:text-pink",
                ]}
              >
                {category}
              </a>
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink">Recent Posts</p>
          <ul class="mt-3 space-y-4">
            {otherPosts.map((p) => (
              <li>
                <a href={`/blog/${p.id}`} class="group flex items-center gap-3">
                  <span
                    class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg text-white"
                    style={{ background: p.data.accent }}
                  >
                    <span class="recent-post-icon h-5 w-5" set:html={coverIcons[p.data.coverIcon]} />
                  </span>
                  <span class="text-sm font-medium text-ink transition-colors group-hover:text-pink">
                    {p.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <div class="mx-auto max-w-3xl px-6 lg:px-10">
      <div class="mt-14 flex flex-wrap items-center gap-4 border-t border-line/70 pt-8">
        <span class="text-sm font-semibold text-ink">Share this article</span>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on LinkedIn"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-pink hover:text-pink"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.55 4.78 5.86V21h-4v-5.5c0-1.31-.02-3-1.86-3-1.86 0-2.14 1.4-2.14 2.9V21h-4V9Z" />
          </svg>
        </a>
        <a
          href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on X"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-pink hover:text-pink"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M18.9 2H22l-7.6 8.7L23.3 22h-7l-5.5-7.2L4.4 22H1.3l8.1-9.3L1 2h7.2l5 6.6L18.9 2Zm-1.2 18h1.7L6.4 3.9H4.6L17.7 20Z" />
          </svg>
        </a>
        <button
          type="button"
          data-copy-link={canonicalURL}
          aria-label="Copy link"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-pink hover:text-pink"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.07 0l2.5-2.5a5 5 0 0 0-7.07-7.07L11 4.88" />
            <path d="M14 11a5 5 0 0 0-7.07 0l-2.5 2.5a5 5 0 0 0 7.07 7.07L13 19.13" />
          </svg>
        </button>
        <span data-copy-status class="text-xs font-medium text-pink opacity-0 transition-opacity">
          Link copied
        </span>
      </div>

      {otherPosts.length > 0 && (
        <div class="mt-14">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink">Keep Reading</p>
          <h2 class="mt-2 font-display text-2xl font-bold text-ink">Related Articles</h2>
          <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {otherPosts.map((p) => (
              <BlogCard post={p} />
            ))}
          </div>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .recent-post-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");

  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.dataset.copyLink;
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      if (status) {
        status.style.opacity = "1";
        setTimeout(() => {
          status.style.opacity = "0";
        }, 1800);
      }
    } catch {
      // Clipboard API unavailable; nothing further to do.
    }
  });
</script>
